# --- Destino ---
BASE_URL=https://srienlinea.sri.gob.ec
CONTEXT_PATH=/sri-sanciones-servicio-internet

# --- OAuth / Keycloak ---
# OJO: 10.12.4.61 es la IP de la VPN. Si el generador de carga no tiene VPN,
# usa la URL pública equivalente (Open Question 3 del plan).
TOKEN_URL=http://10.12.4.61/auth/realms/Internet/protocol/openid-connect/token
CLIENT_ID=app-sri-declaraciones-web-internet_cfcg
SRI_USER=
SRI_PASS=

# --- Perfil de carga (etapas) ---
RAMP_UP=30s
VUS_RAMP=20
SOSTEN=2m
VUS_MAX=50
RAMP_DOWN=30s

# Think time entre operaciones de una iteración. 0 = lazo cerrado.
# THINK_TIME=1 => ~1 s por iteración
THINK_TIME=0

# --- Umbrales (ms) ---
P95_MAX_MS=2000
P99_MAX_MS=5000
MAX_ERR_RATE=0.01
MIN_CHECK_RATE=0.99

# --- Comportamiento de auth ---
# Margen antes de expiracion para refrescar + jitter por VU (evita rafaga)
TOKEN_REFRESH_MARGIN_S=60
TOKEN_REFRESH_JITTER_S=30

# --- Check del GET de interes ---
# Codigo correcto cuando la consulta no tiene datos (Open Question 1 del plan).
# Por defecto solo 200. Si el servicio responde 404 con cuerpo explicito,
# agregar: OK_GET_STATUSES=200,404
OK_GET_STATUSES=200
OK_POST_STATUSES=200

# --- Generacion de payload POST ---
# Plantilla de fechas/valor usada para derivar el cuerpo de cada iteracion.
# Formato dd/mm/aaaa
POST_DIA=31
POST_MES=12
POST_ANIO=2024
POST_VALOR_INTERES=100.50

# --- Autenticacion de la corrida (pasada a k6) ---
# Recomendado: 0 para un smoke unico
SMOKE_ITERATIONS=1

# Ejecutar el POST durante la carga. 0 = solo GET (modo seguro por defecto).
ENABLE_POST=1
