# --- Destino ---
BASE_URL=https://srienlinea.sri.gob.ec
CONTEXT_PATH=/sri-sanciones-servicio-internet

# --- OAuth / Keycloak ---
# El realm cuelga del MISMO host que la app, asi que TOKEN_URL se deriva solo:
#   BASE_URL + TOKEN_PATH
# k6 no necesita VPN a 10.12.4.61.
# Dejar TOKEN_URL vacio para usar la derivacion. Solo llenarlo si el realm
# vive en otro host (si no, sobreescribe la derivacion).
TOKEN_PATH=/auth/realms/Internet/protocol/openid-connect/token
TOKEN_URL=
CLIENT_ID=sri-cliente-generico-sso-internet
SRI_USER=
SRI_PASS=

# --- Perfil de carga (etapas) ---
RAMP_UP=30s
VUS_RAMP=20
SOSTEN=2m
VUS_MAX=50
RAMP_DOWN=30s

# Think time entre operaciones de una iteración. 0 = lazo cerrado.
# THINK_TIME=1 => ~1 s por iteración
THINK_TIME=0

# --- Umbrales (ms) ---
P95_MAX_MS=2000
P99_MAX_MS=5000
MAX_ERR_RATE=0.01
MIN_CHECK_RATE=0.99

# --- Comportamiento de auth ---
# Margen antes de expiracion para refrescar + jitter por VU (evita rafaga)
TOKEN_REFRESH_MARGIN_S=60
TOKEN_REFRESH_JITTER_S=30

# --- Check del GET de interes ---
# Codigo correcto cuando la consulta no tiene datos (Open Question 1 del plan).
# Por defecto solo 200. Si el servicio responde 404 con cuerpo explicito,
# agregar: OK_GET_STATUSES=200,404
OK_GET_STATUSES=200
OK_POST_STATUSES=200

# --- Generacion de payload POST (fuera de alcance actual) ---
# Solo se usa si ENABLE_POST=1. No hace falta tocarlo mientras sea 0.
# Formato dd/mm/aaaa
POST_DIA=31
POST_MES=12
POST_ANIO=2024
POST_VALOR_INTERES=100.50

# Ejecutar el POST durante la carga. 0 = solo GET interes.
# 0 es el valor por defecto en el codigo: la corrida en alcance no ejercita la
# escritura. NO pongas 1 sin haber verificado que el POST no persiste
# (pre-flight paso 4) y sin tener el payload real en data/multaDeclaracion.json.
ENABLE_POST=0
